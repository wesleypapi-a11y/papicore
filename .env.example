PORT=3000

# Segredo usado para assinar os tokens JWT do painel administrativo
# Troque por um valor aleatório e longo em produção
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio

# Tempo de expiração do token de administrador (ex: 8h, 1d)
JWT_EXPIRES_IN=8h

# Caminho do arquivo do banco SQLite (relativo à raiz do projeto)
DB_FILE=data/app.db

# Credenciais do administrador inicial criadas automaticamente na primeira execução
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123

# --- WhatsApp Cloud API (Meta) ---
# Token de acesso permanente da Meta (System User / WhatsApp Business)
WHATSAPP_TOKEN=
# ID do número de telefone da loja cadastrado no WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# URL base da API (padrão oficial)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

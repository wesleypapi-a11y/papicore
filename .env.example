PORT=3000

# Ambiente (development | production)
NODE_ENV=development

# OBRIGATÓRIO em qualquer ambiente (inclusive Render). Se não estiver
# configurado, o servidor recusa iniciar (ver server.js). Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio

# Tempo de expiração do token de administrador (ex: 8h, 1d)
JWT_EXPIRES_IN=8h

# --- Plataforma Papi Core ---
# Nome interno da plataforma (não aparece para os clientes)
PLATFORM_NAME=Papi Core
# Em desenvolvimento, o host localhost usa o tenant padrão
DEFAULT_TENANT_SLUG=torque-detail
# Domínio da plataforma e IP do servidor (usados nas instruções de DNS)
PLATFORM_DOMAIN=app.papi.app
SAAS_CNAME_TARGET=app.papi.app
PLATFORM_SERVER_IP=

# Credenciais do desenvolvedor (criadas automaticamente na primeira execução)
DEVELOPER_NAME=Desenvolvedor
DEVELOPER_EMAIL=seu-email@exemplo.com
DEVELOPER_PASSWORD=use-uma-senha-forte-com-12-ou-mais-caracteres

# Domínio principal do primeiro cliente
TORQUE_DETAIL_DOMAIN=torquedetail.com.br
TORQUE_DETAIL_ADMIN_NAME=Administrador Torque Detail
TORQUE_DETAIL_ADMIN_EMAIL=admin@torquedetail.exemplo
TORQUE_DETAIL_ADMIN_PASSWORD=use-uma-senha-forte-com-12-ou-mais-caracteres
# Opcional; vazio usa o primeiro plano ativo. Em produção, o seed também exige ALLOW_TORQUE_DETAIL_SEED=true.
TORQUE_DETAIL_PLAN=
ALLOW_TORQUE_DETAIL_SEED=false

# Credenciais do administrador inicial do primeiro cliente
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.exemplo
ADMIN_PASSWORD=use-outra-senha-forte-com-12-ou-mais-caracteres

# --- WhatsApp Cloud API (Meta) ---
# Token de acesso permanente da Meta (System User / WhatsApp Business)
WHATSAPP_TOKEN=
# ID do número de telefone da loja cadastrado no WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# URL base da API (padrão oficial)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

PORT=3000

# Ambiente (development | production)
NODE_ENV=development

# Onde ficam os bancos de dados, backups e assets de identidade visual
# (logos e favicons dos tenants). Em desenvolvimento, deixe vazio: usa ./data.
# Em produção (Render), configure um caminho persistente, ex.: /var/data.
# OBS: sem Persistent Disk no Render, arquivos e bancos são perdidos a cada deploy.
DATA_DIR=

# OBRIGATÓRIO em qualquer ambiente (inclusive Render). Se não estiver
# configurado, o servidor recusa iniciar (ver server.js). Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio

# Tempo de expiração do token de administrador (ex: 8h, 1d)
JWT_EXPIRES_IN=8h

# --- Plataforma PapiCore ---
# Nome interno da plataforma (não aparece para os clientes)
PLATFORM_NAME=PapiCore
# Em desenvolvimento, o host localhost usa o tenant padrão
DEFAULT_TENANT_SLUG=torque-detail
# Domínio institucional da plataforma: a raiz abre a landing page comercial
# (public/landing.html) em vez da página de agendamento de um tenant. Em
# desenvolvimento, localhost também abre a landing page. O Painel do
# Desenvolvedor continua em /desenvolvedor. Clientes apontam seus domínios
# para SAAS_CNAME_TARGET.
PLATFORM_DOMAIN=papicore.com.br
# Endereço técnico usado como alvo de CNAME dos domínios dos clientes.
SAAS_CNAME_TARGET=app.papicore.com.br
PLATFORM_SERVER_IP=

# Credenciais do desenvolvedor (criadas automaticamente na primeira execução)
DEVELOPER_NAME=Desenvolvedor
DEVELOPER_EMAIL=seu-email@exemplo.com
DEVELOPER_PASSWORD=use-uma-senha-forte-com-12-ou-mais-caracteres

# Domínio principal do primeiro cliente
TORQUE_DETAIL_DOMAIN=torquedetail.com.br
TORQUE_DETAIL_ADMIN_NAME=Administrador Torque Detail
TORQUE_DETAIL_ADMIN_EMAIL=admin@torquedetail.exemplo
TORQUE_DETAIL_ADMIN_PASSWORD=use-uma-senha-forte-com-12-ou-mais-caracteres
# Opcional; vazio usa o primeiro plano ativo. Em produção, o seed também exige ALLOW_TORQUE_DETAIL_SEED=true.
TORQUE_DETAIL_PLAN=
ALLOW_TORQUE_DETAIL_SEED=false

# --- Backups locais (Fase 1) ---
# Retenção por idade (dias): backups de sucesso mais antigos são removidos.
BACKUP_LOCAL_RETENTION_DAYS=7
# Retenção por quantidade: máx. de backups mantidos por empresa.
BACKUP_LOCAL_MAX_PER_TENANT=10
# Habilita a rotina automática (produção). Em desenvolvimento permanece desligada.
BACKUP_LOCAL_ENABLED=true
# Expressão cron da rotina diária.
BACKUP_LOCAL_SCHEDULE=0 3 * * *
# Fuso horário da agenda (IANA).
BACKUP_TIMEZONE=America/Sao_Paulo
# Roda uma rodada automática no boot do servidor (true/false).
BACKUP_RUN_ON_START=false
# Espaço livre mínimo em disco (MB) para permitir gerar um backup.
BACKUP_MIN_FREE_SPACE_MB=200

# Credenciais do administrador inicial do primeiro cliente
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.exemplo
ADMIN_PASSWORD=use-outra-senha-forte-com-12-ou-mais-caracteres

# --- Recuperação de senha (painel administrativo dos tenants) ---
# Habilita o envio do e-mail de recuperação de senha via Brevo. Pode também
# ser ligado/desligado pelo Painel do Desenvolvedor > Configurações
# (o que for configurado por lá tem prioridade sobre estas variáveis).
EMAIL_ENABLED=false
# Chave da API transacional da Brevo (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Remetente verificado na Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PapiCore

# Validade do link de recuperação de senha, em minutos
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Limite de solicitações de recuperação por IP
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5

# --- WhatsApp Cloud API (Meta) ---
# Token de acesso permanente da Meta (System User / WhatsApp Business)
WHATSAPP_TOKEN=
# ID do número de telefone da loja cadastrado no WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# URL base da API (padrão oficial)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
